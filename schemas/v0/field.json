{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field.json",
  "title": "Sport package field / court geometry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "surface", "units", "width", "length", "markings"],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "surface": {
      "type": "string",
      "enum": ["court", "pitch", "other"]
    },
    "units": {
      "type": "string",
      "enum": ["m", "ft"]
    },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "length": { "type": "number", "exclusiveMinimum": 0 },
    "markings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "geometry"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/NonEmptyString" },
          "kind": {
            "type": "string",
            "enum": ["boundary", "center", "goal", "key", "arc", "other"]
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "points"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["polyline", "polygon", "circle"]
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              },
              "radius": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
