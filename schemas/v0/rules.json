{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.json",
  "title": "Sport package rules (declarative)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variant_id", "clock", "scoring", "periods"],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "variant_id": { "$ref": "common.json#/$defs/VariantId" },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "period_duration_ms"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["countdown", "countup", "manual_only"]
        },
        "period_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "shot_clock_ms": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "allowed_point_values"],
      "properties": {
        "unit": { "$ref": "common.json#/$defs/NonEmptyString" },
        "allowed_point_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "periods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "label"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "label": { "$ref": "common.json#/$defs/NonEmptyString" },
        "overtime_allowed": { "type": "boolean" }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/NonEmptyString" },
          "description": { "$ref": "common.json#/$defs/NonEmptyString" }
        }
      }
    }
  }
}
