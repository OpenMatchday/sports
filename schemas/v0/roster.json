{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roster.json",
  "title": "Sport package roster model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "positions", "limits"],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": { "$ref": "common.json#/$defs/NonEmptyString" },
          "markers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["captain", "goalkeeper", "none"]
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_field_min", "on_field_max", "bench_max"],
      "properties": {
        "on_field_min": { "type": "integer", "minimum": 1 },
        "on_field_max": { "type": "integer", "minimum": 1 },
        "bench_max": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
