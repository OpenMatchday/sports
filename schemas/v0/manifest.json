{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.json",
  "title": "Sport package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "version",
    "fiction",
    "variants",
    "default_locale",
    "exceptional_modules"
  ],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.json#/$defs/PackageId" },
    "display_name": { "$ref": "common.json#/$defs/NonEmptyString" },
    "version": { "$ref": "common.json#/$defs/SemVer" },
    "fiction": {
      "type": "boolean",
      "description": "true for schema fixtures and fictional test sports; false only for packages citing real governing-body rules"
    },
    "summary": { "$ref": "common.json#/$defs/NonEmptyString" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.json#/$defs/VariantId" }
    },
    "default_locale": { "$ref": "common.json#/$defs/LocaleTag" },
    "exceptional_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.json#/$defs/RelativePath" },
      "description": "Module paths relative to this package root. Each path must also appear on the repo static allowlist (AC-6.2)."
    }
  }
}
