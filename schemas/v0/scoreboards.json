{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoreboards.json",
  "title": "Sport package scoreboard field map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fields"],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "value_type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": { "$ref": "common.json#/$defs/NonEmptyString" },
          "value_type": {
            "type": "string",
            "enum": ["integer", "clock_ms", "string", "boolean"]
          },
          "optional_for_variants": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/VariantId" }
          }
        }
      }
    }
  }
}
